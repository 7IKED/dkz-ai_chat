// COSMO // desktop als Einzel-Tab (fuer Alt+1 NewTab-Shortcut)
layout {
    pane split_direction="vertical" {
        pane size="60%" name="EDITOR" focus=true {
            command "bash"
            args "-lc" "${EDITOR:-nano} . 2>/dev/null || ${EDITOR:-vi} . 2>/dev/null || exec bash"
        }
        pane split_direction="horizontal" {
            pane name="SYSMON" {
                command "bash"
                args "-lc" "btop 2>/dev/null || htop 2>/dev/null || top"
            }
            pane name="SHELL" {
                command "bash"
            }
        }
    }
}
