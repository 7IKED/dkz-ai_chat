#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════╗
# ║  OPEN AI TERMINAL // LAUNCHER  ·  DEVKiTZ                          ║
# ╚══════════════════════════════════════════════════════════════════╝
#  odysseus              Terminal starten (Stack muss laufen: odysseus up)
#  odysseus up|down      Docker-Stack starten/stoppen (up --nextcloud: Zweit-Cloud)
#  odysseus status       Systemstatus
#  odysseus init         Gitea einrichten (Admin/Org/Repo) + Repo pushen
#  odysseus gitviz ...   Repos sichtbar machen (graph·activity·authors·repos)
#  odysseus chat ...     Chat MIT Werkzeugen (list·schema·call·ask)
#  odysseus uri ...      URI-Handler oat://  (install·list·test)
#  odysseus design ...   Cloud Design System (build·apply·styleguide)
#  odysseus vault ...    Agenten-Vault
#  odysseus skills ...   Skill-Import (Repo/YouTube-Link → Skills+Workflows)
#  odysseus say "..."    Voicebox
#  odysseus browse [x]   Dienste im Terminal-Browser
set -uo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    D="$(cd -P "$(dirname "$SOURCE")" && pwd)"; SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$D/$SOURCE"
done
export ODYSSEUS_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
G='\033[38;5;46m'; R='\033[38;5;196m'; DIM='\033[38;5;28m'; N='\033[0m'

# .env laden (Ports, Admin) falls vorhanden
[ -f "$ODYSSEUS_DIR/.env" ] && { set -a; . "$ODYSSEUS_DIR/.env"; set +a; }

S="$ODYSSEUS_DIR/scripts"

case "${1:-terminal}" in
    up|down|status|logs) A="$1"; shift; "$S/odysseus-ctl.sh" "$A" "$@";;
    init)   "$S/gitea-init.sh" setup && "$S/gitea-init.sh" push;;
    vault)  shift; "$S/vault.sh" "$@";;
    skills) shift; "$S/skill-import.sh" "$@";;
    gitviz) shift; "$S/gitviz.sh" "$@";;
    uri)    shift; "$S/uri.sh" "$@";;
    chat)   shift
            # 'chat' ist jetzt der Chat MIT Werkzeugen. Die alten
            # A2A-Unterbefehle bleiben, wo sie waren.
            case "${1:-repl}" in
                a2a|inbox) "$S/nanochat.sh" "$@";;
                *)         "$S/chat-tools.sh" "$@";;
            esac;;
    tools)  shift; "$S/chat-tools.sh" "${1:-list}" "${@:2}";;
    design) shift
            case "${1:-build}" in
                build)      "$ODYSSEUS_DIR/design/build.sh" "${@:2}";;
                apply)      "$ODYSSEUS_DIR/design/apply-theme.sh" "${@:2}";;
                check)      "$ODYSSEUS_DIR/design/build.sh" --check;;
                styleguide) "$S/browser.sh" "file://$ODYSSEUS_DIR/design/styleguide.html";;
                *)          echo "usage: odysseus design [build|check|apply|styleguide]";;
            esac;;
    say)    shift; "$S/voice.sh" "$@";;
    browse) shift; "$S/browser.sh" "$@";;
    terminal)
        command -v zellij >/dev/null 2>&1 || { echo -e "${R}[OAT] zellij fehlt — ../multiplexer/install.sh${N}"; exit 127; }
        [ -f "$ODYSSEUS_DIR/design/dist/oat-tokens.sh" ] || "$ODYSSEUS_DIR/design/build.sh" >/dev/null 2>&1
        exec zellij --config "$ODYSSEUS_DIR/config/config.kdl" \
                    --session odysseus \
                    --new-session-with-layout "$ODYSSEUS_DIR/layouts/odysseus.kdl"
        ;;
    -h|--help|help) sed -n '5,16p' "$0";;
    *) sed -n '5,16p' "$0";;
esac
