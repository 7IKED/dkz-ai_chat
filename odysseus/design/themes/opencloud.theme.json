              "role-on-surface-variant": "#5a6b5a",
              "role-surface-variant": "#050a05",
              "role-primary": "#00FF41",
              "role-on-primary": "#000000",
              "role-primary-container": "#0e2410",
              "role-on-primary-container": "#00FF41",
              "role-secondary": "#008F11",
              "role-on-secondary": "#000000",
              "role-secondary-container": "#004d0a",
              "role-on-secondary-container": "#00FF41",
              "role-error": "#ff3333",
              "role-on-error": "#000000",
              "role-error-container": "#4d0f0f",
              "role-on-error-container": "#ff5c5c",
