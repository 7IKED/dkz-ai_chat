{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "OPEN AI TERMINAL // Cloud Design System",
  "version": "1.0.0",
  "description": "Ein Token-Satz fuer alle Oberflaechen: Terminal (Zellij/ANSI), Web-UIs (OpenCloud, Nextcloud, Gitea, LibreChat) und eigene Seiten. Quelle der Wahrheit — css/tokens.css und themes/* werden hieraus gebaut (build.sh).",

  "color": {
    "bg": {
      "base":      { "value": "#000000", "ansi": 0,   "use": "Seitenhintergrund, Terminal-Background" },
      "sunken":    { "value": "#030703", "ansi": 233, "use": "Ebene unter der Flaeche (Wells, Code)" },
      "surface":   { "value": "#050a05", "ansi": 234, "use": "Karten, Panes, Panels" },
      "raised":    { "value": "#070d07", "ansi": 235, "use": "Modals, Popover, Kopfzeilen" },
      "hover":     { "value": "#0b160b", "ansi": 236, "use": "Hover-Flaeche" },
      "selected":  { "value": "#0e2410", "ansi": 22,  "use": "Aktive Zeile / Auswahl" }
    },
    "fg": {
      "primary":   { "value": "#00FF41", "ansi": 46,  "use": "Haupttext, Prompt, Aktive Icons" },
      "accent":    { "value": "#39FF14", "ansi": 82,  "use": "Hervorhebung, Fokus, Links" },
      "muted":     { "value": "#008F11", "ansi": 28,  "use": "Sekundaertext, Rahmen, Labels" },
      "faint":     { "value": "#004d0a", "ansi": 22,  "use": "Trenner, Deaktiviert" },
      "neutral":   { "value": "#e5e7eb", "ansi": 255, "use": "Lesetext in langen Absaetzen" },
      "grey":      { "value": "#5a6b5a", "ansi": 244, "use": "Metadaten, Zeitstempel" }
    },
    "state": {
      "ok":        { "value": "#00FF41", "ansi": 46,  "use": "ONLINE, pass, erfolgreich" },
      "warn":      { "value": "#ffb000", "ansi": 214, "use": "Wartung, Aufmerksamkeit" },
      "error":     { "value": "#ff3333", "ansi": 196, "use": "OFFLINE, fail, Fehler" },
      "info":      { "value": "#00d4ff", "ansi": 45,  "use": "Hinweis, Uplink, URI" }
    },
    "border": {
      "subtle":    { "value": "#004d0a", "use": "Standardrahmen (1px)" },
      "default":   { "value": "#008F11", "use": "Karten, Panes" },
      "strong":    { "value": "#00FF41", "use": "Fokus, aktiver Tab" }
    }
  },

  "typography": {
    "family": {
      "mono": { "value": "ui-monospace, 'Cascadia Code', 'JetBrains Mono', 'Courier New', monospace", "use": "alles — das System ist durchgehend monospaced" }
    },
    "size": {
      "xs":  { "value": "11px" },
      "sm":  { "value": "13px" },
      "md":  { "value": "15px" },
      "lg":  { "value": "18px" },
      "xl":  { "value": "24px" },
      "2xl": { "value": "34px" },
      "3xl": { "value": "clamp(34px, 7vw, 88px)" }
    },
    "weight": { "regular": { "value": "400" }, "bold": { "value": "700" }, "black": { "value": "800" } },
    "leading": { "tight": { "value": "1.15" }, "normal": { "value": "1.55" }, "loose": { "value": "1.7" } },
    "tracking": { "tight": { "value": "0" }, "wide": { "value": "1px" }, "wider": { "value": "2px" }, "widest": { "value": "4px" } }
  },

  "space": {
    "0": { "value": "0" },   "1": { "value": "4px" },  "2": { "value": "8px" },
    "3": { "value": "12px" },"4": { "value": "16px" }, "5": { "value": "24px" },
    "6": { "value": "32px" },"7": { "value": "48px" }, "8": { "value": "64px" }
  },

  "radius": {
    "none": { "value": "0", "use": "Standard — das System ist eckig (Terminal-Look)" },
    "sm":   { "value": "2px", "use": "nur wo eine Fremd-UI Rundung erzwingt" }
  },

  "border-width": { "hairline": { "value": "1px" }, "thick": { "value": "2px" } },

  "shadow": {
    "glow":       { "value": "0 0 10px rgba(0,255,65,.45)", "use": "Text-Glow" },
    "glow-strong":{ "value": "0 0 22px rgba(0,255,65,.75)", "use": "Titel, Fokus" },
    "pane":       { "value": "inset 0 0 40px rgba(0,255,65,.04), 0 0 24px rgba(0,255,65,.06)", "use": "Karten/Panes" }
  },

  "motion": {
    "fast":   { "value": "120ms" },
    "normal": { "value": "250ms" },
    "slow":   { "value": "500ms" },
    "ease":   { "value": "cubic-bezier(.2,.7,.3,1)" }
  },

  "effect": {
    "scanline": { "value": "3px", "use": "CRT-Rasterabstand (::after-Overlay)" },
    "vignette": { "value": "radial-gradient(ellipse at center, transparent 55%, rgba(0,0,0,.55) 100%)" }
  },

  "layout": {
    "pane-padding":  { "value": "clamp(16px, 2.5vw, 32px)" },
    "content-max":   { "value": "72ch" },
    "grid-gap":      { "value": "clamp(12px, 1.6vw, 20px)" },
    "breakpoint-sm": { "value": "640px" },
    "breakpoint-md": { "value": "820px" },
    "breakpoint-lg": { "value": "1200px" }
  }
}
