# OPEN AI TERMINAL // Umgebung — kopieren nach .env und anpassen!
# Alle Dienste binden nur an 127.0.0.1 (geschlossenes System).

# Admin-Zugang (OpenCloud-Admin, Nextcloud-Erstinstallation)
ADMIN_USER=admin
ADMIN_PASS=BITTE-AENDERN

# Ports (bei Konflikten anpassen)
GITEA_PORT=3300
GITEA_SSH_PORT=2222
OPENCLOUD_PORT=9200
NEXTCLOUD_PORT=8081       # nur bei --profile nextcloud
IMMICH_PORT=2283
LIBRECHAT_PORT=3080
ATUIN_PORT=8888
VOICE_PORT=10200

# Interne DB-Passwoerter
IMMICH_DB_PASS=BITTE-AENDERN
ATUIN_DB_PASS=BITTE-AENDERN

# LibreChat Secrets (lange Zufallswerte!)
JWT_SECRET=BITTE-AENDERN-LANG
JWT_REFRESH_SECRET=BITTE-AENDERN-LANG-2

# Voicebox-Stimme (Piper): de_DE-thorsten-medium, en_US-amy-medium, ...
VOICE_MODEL=de_DE-thorsten-medium

# Gitea-Theme aus dem Cloud Design System systemweit erzwingen
# (erst nach `design/apply-theme.sh gitea` setzen — vorher kennt Gitea es nicht)
#GITEA__ui__DEFAULT_THEME=oat-matrix

# ── Chat-Werkzeuge (scripts/chat-tools.sh) ──────────────────────────
# Modell mit Tool-Calling-Faehigkeit. Getestet: qwen2.5, llama3.1/3.2, mistral-nemo
NANOCHAT_MODEL=llama3.2
OLLAMA_URL=http://127.0.0.1:11434
# Gitea-Token fuer Repo-Visualisierung + Chat-Werkzeuge (leer = nur oeffentliche
# Repos). Anlegen: Gitea → Einstellungen → Anwendungen → Token generieren.
# Besser noch im Vault: odysseus vault set api/gitea
GITEA_TOKEN=
# Werkzeuge, die Schreibrechte haetten, sind standardmaessig AUS.
# Einschalten nur, wenn du dem Modell das wirklich erlauben willst:
OAT_TOOLS_ALLOW_WRITE=0
